{
  "id": "./",
  "name": "Sketchnote",
  "short_name": "Sketchnote",
  "description": "Local-first drawing and image annotation",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#202124",
  "theme_color": "#202124",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "Open image in Sketchnote",
      "accept": {
        "image/webp": [
          ".webp"
        ],
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ]
      },
      "launch_type": "multiple-clients"
    }
  ]
}